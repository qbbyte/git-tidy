{
  "name": "git-tidy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check:conflict": "node --experimental-strip-types scripts/check-conflict.mjs",
    "check:conflict-real": "powershell -ExecutionPolicy Bypass -File scripts/verify-conflict.ps1",
    "check:tokens": "node --experimental-strip-types scripts/check-tokens.mjs",
    "check:pane": "node --experimental-strip-types scripts/check-pane-divider.mjs",
    "check:highlight": "node --experimental-strip-types scripts/check-highlight.mjs",
    "check:ai": "node --experimental-strip-types scripts/check-ai.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "@vicons/tabler": "^0.13.0",
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.13",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
